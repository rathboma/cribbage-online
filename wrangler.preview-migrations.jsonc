// Only for applying D1 migrations to the database every Preview shares (see wrangler.jsonc,
// `previews`). Wrangler's D1 commands look at top-level databases, so this file names the
// Preview database there. It is never deployed. The "Preview database" GitHub Actions workflow
// runs this whenever a pull request changes a migration; by hand, from the repository root:
//
//   npx wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc
// https://developers.cloudflare.com/workers/previews/resources/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cribbage-online",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      // Must match the previews.d1_databases entry in wrangler.jsonc.
      "database_name": "cribbage-preview",
      "database_id": "e5cd0734-c01b-4733-aea6-237e334d6908",
      "migrations_dir": "migrations",
    },
  ],
}
