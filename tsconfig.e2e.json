// End-to-end tests: run by Playwright in Node, with callbacks that run in the browser page.
{
  "extends": "./tsconfig.node.json",
  "include": ["e2e/**/*.ts"],
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
