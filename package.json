{
  "name": "cribbage-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two-player cribbage in the browser, no signup required.",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "yarn -s db:migrate:local && run-p --race dev:api dev:client",
    "dev:client": "vite",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8788 --show-interactive-dev-session=false",
    "build": "vite build && yarn -s build:functions",
    "build:functions": "wrangler pages functions build --outdir .wrangler/functions-build",
    "preview": "vite preview",
    "preview:worker": "yarn -s db:migrate:local && wrangler dev",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:serve": "sh scripts/e2e-serve.sh",
    "db:migrate:local": "wrangler d1 migrations apply cribbage --local",
    "deploy": "sh scripts/deploy.sh",
    "bot:play": "tsx scripts/bot-play.ts",
    "cards:optimize": "tsx scripts/optimize-cards.ts",
    "cards:compare": "tsx scripts/compare-cards.ts"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "pinia": "^4.1.0",
    "three": "0.187.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "sharp": "0.34.5",
    "svgo": "4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.162.0"
  }
}
