// Server tests: run inside workerd by @cloudflare/vitest-plugin.
{
  "extends": "./tsconfig.worker.json",
  "include": ["server/**/*.test.ts", "server/test/**/*.ts"],
  "exclude": ["server/test/global-setup.ts"],
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server-test.tsbuildinfo"
  }
}
