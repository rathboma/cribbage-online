# Cloudflare static-asset headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Everything Vite builds into /assets/ (scripts, styles, card art) has a hash of its contents in
# its file name, so a file at a given URL never changes: browsers may keep it for a year without
# asking again. New content always gets a new URL. (index.html is not under /assets/ and keeps
# the default, revalidated on every visit, so it always points at the current files.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
