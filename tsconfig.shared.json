// Isomorphic code used by both the client and the server.
// No DOM, Node or Cloudflare types here, so anything platform-specific fails to compile.
{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["shared/**/*.ts"],
  "exclude": ["shared/**/*.test.ts"],
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@shared/*": ["./shared/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.shared.tsbuildinfo"
  }
}
