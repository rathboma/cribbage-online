// Cloudflare Worker config: the built client (dist/) is served as static assets, and the API in
// functions/ runs as the Worker. See README "Local Cloudflare workflow" and "Deployment".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cribbage-online",
  // The API: functions/ compiled into one Worker by `yarn build` (wrangler pages functions build).
  "main": "./.wrangler/functions-build/index.js",
  "compatibility_date": "2026-11-01",
  // `wrangler deploy` (Cloudflare's default deploy command) builds the client and the Worker first.
  "build": {
    "command": "yarn build",
    // `wrangler dev` rebuilds the API when these change (the client is served by Vite in dev).
    "watch_dir": ["functions", "server", "shared"],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A path that matches no file goes to the Worker (functions/[[path]].ts): deep links such
    // as /j/BCDFG get index.html, and a missing file gets a real 404. Cloudflare's own
    // "single-page-application" fallback would answer a missing /assets/ file with index.html,
    // which browsers would then cache for a year (public/_headers).
    "not_found_handling": "none",
    // API requests always reach the Worker; files are served straight from the assets.
    "run_worker_first": ["/api/*"],
  },
  // Overridden locally by .dev.vars. Only "development" and "test" allow TEST_SEED.
  "vars": {
    "ENVIRONMENT": "production",
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: the first `wrangler deploy` creates a database with this name (or uses
      // the existing one), and the d1 commands find it by name.
      "database_name": "cribbage",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Pull-request branches are built by Cloudflare as Previews (`wrangler preview`), which get only
  // what is listed here, never the production settings above. All Previews share one database of
  // their own, cribbage-preview, so they never touch production data. Its migrations are applied
  // with wrangler.preview-migrations.jsonc (see README "Deployment"), not automatically.
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "cribbage-preview",
        "database_id": "e5cd0734-c01b-4733-aea6-237e334d6908",
        "migrations_dir": "migrations",
      },
    ],
  },
}
